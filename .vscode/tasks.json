{
    // See https://go.microsoft.com/fwlink/?inkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Tests",
            "type": "shell",
            "command": "./build test ${input:exec}",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "focus": true
            }
        },
        {
            "label": "Build All",
            "type": "shell",
            "command": "./build all",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "focus": true
            }
        }
    ],
    "inputs": [
        {
          "type": "pickString",
          "id": "exec",
          "description": "Which lib would you like to run?",
          // dynamically populated by update_vscode_configs() in ./build
          "options": [
            "interface",
            "observer",
            "ring_buffer",
            "state_machine"
          ]
        }
    ]
}
