    "version": "0.2.0",
    "configurations": [
        {
            "name": "LLDB",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/out/tests/${input:exec}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build All"
        }
    ],
    "inputs": [
        {
          "type": "pickString",
          "id": "exec",
          "description": "Which lib would you like to run?",
          // dynamically populated by update_vscode_configs() in ./build
          "options": [
            "callback",
            "callback_queue",
            "callback_table",
            "interface",
            "ring_buffer",
            "state_machine"
          ]
        }
    ]
  }
